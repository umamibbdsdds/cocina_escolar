# ============================================================
#  Variables de entorno
# ============================================================
# EN RAILWAY NO NECESITAS LLENAR ESTE ARCHIVO.
# Railway inyecta solo PORT y, al enlazar el servicio MySQL,
# tambien MYSQLHOST / MYSQLPORT / MYSQLUSER / MYSQLPASSWORD / MYSQLDATABASE
# (o MYSQL_URL). El codigo las detecta automaticamente.
#
# Este archivo solo sirve de REFERENCIA o para correr en tu PC local.
# ------------------------------------------------------------

# --- Opcion A: una sola URL de conexion (lo que da Railway) ---
# MYSQL_URL=mysql://usuario:password@host:puerto/basededatos

# --- Opcion B: variables sueltas ---
# MYSQLHOST=localhost
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=tu_contrasena
# MYSQLDATABASE=cocina_escolar

# --- Puerto (Railway lo pone solo, no lo definas alla) ---
# PORT=3000
